# Copy to .env. Obtain the host, user and port from Supabase Dashboard > Connect.
# A session pooler connection uses port 5432 and user postgres.PROJECT_REF.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rentique
DB_USER=rentique
DB_PASSWORD=
# Use require for a Supabase connection, disable for a loopback-only local server.
DB_SSLMODE=disable
# Set true when serving over HTTPS.
SESSION_SECURE=false
